[Unit]
Description=Daisy Feeder (TikTok gift -> feed drop)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
EnvironmentFile=/etc/duckfeeder.env
StateDirectory=duckfeeder
ExecStart=/usr/bin/python3 /opt/duckfeeder/feeder.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
