# Duck Feeder settings. After editing:  sudo systemctl restart duckfeeder

# Secret key TikFinity must include in the URL (install.sh generates one)
FEEDER_KEY=change-me

# Network port for the web server
FEEDER_PORT=5000

# Servo signal pin (BCM numbering). 18 = physical pin 12
SERVO_PIN=18

# Flap positions in degrees (use calibrate.py to find yours)
OPEN_ANGLE=90
CLOSED_ANGLE=0

# How long the flap stays open per portion. Bigger = more feed
OPEN_SECONDS=0.5

# How many open/close cycles one gift triggers
PORTIONS_PER_FEED=1

# Minimum seconds between feeds, however many gifts arrive
COOLDOWN_SECONDS=20

# Max feeds per day. Set this x portion size to a healthy daily amount for the duck
DAILY_MAX=30

# How many gifts can wait in line before extras are refused
MAX_QUEUE=5

# Set to 1 to test without a servo attached
FEEDER_MOCK=0
